{
  "compilerOptions": {
    "declaration": true,
    "module": "Node16",
    "esModuleInterop": true,
    "target": "es6",
    "moduleResolution": "node16",
    "sourceMap": true,
    "outDir": "dist",
     "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false // Importante para MikroORM y decoradores
  },
  "lib": ["es2015"]
}

